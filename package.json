{
  "name": "tom-photo-vite-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --watch-path=server/index.js --watch-path=server/database.js --watch-path=server/lib server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "setup:admin": "node scripts/setup-admin.mjs",
    "ports": "node scripts/ports.mjs",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "concurrently": "^9.2.0",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.2",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "jspdf": "^4.2.1",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.16",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "vite": "^7.1.4",
    "zod": "^4.1.5"
  }
}
